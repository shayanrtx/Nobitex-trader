# ── Copy to .env and fill in. NEVER commit .env ──────────────────────────────

# paper = simulated orders on live prices (default), live = real orders
NBX_MODE=paper

# Option A (simple): token from https://nobitex.ir/app/settings/
NBX_API_TOKEN=

# Option B (recommended for bots): API key with READ+TRADE only (never WITHDRAW),
# IP-whitelisted. Takes precedence over the token.
NBX_API_KEY=
NBX_API_PRIVATE_KEY=

# Dashboard password (long random string):
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
NBX_DASHBOARD_TOKEN=

# Notifications (Telegram-compatible Bot API; for Bale set notify.api_base in config.yaml)
NBX_NOTIFY_BOT_TOKEN=
